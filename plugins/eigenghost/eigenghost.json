    {"name": "Small room", "values": {"decay": 0.8, "dry": 0, "wet": -10, "size": 4, "predelay": 4, "pitch1": 12, "pitch2": -12, "shimmer": 0, "reverse": 0, "diffusion": 70, "diffuserSize": 0.8, "spread": 2.5, "bulge": 0.6, "damping": 5000, "lowCut": 40, "modDepth": 3, "width": 100}}
