{
  "name": "meter",
  "displayname": "JP Meter",
  "plugintype": "AnalyserPlugin",
  "color": "RTA",
  "major": 0,
  "minor": 1,
  "micro": 0,
  "shortdescription": "Test plugin: measures a signal against a reference",
  "description": [
    "Test plugin of jaypacks-dwarf-dsp: measures in place and reports the results on control outputs (docs/plugins/meter.md).",
    "Input 1 is the signal (passed through to the output), input 2 a reference, e.g. the signal before the plugin under test.",
    "Measurements run in windows of Window seconds, back to back; at the end of a window every output holds its result. A new value on Measure starts a new window at once, and Result id reports the Measure value of the window a result comes from.",
    "Levels are dBFS (floor -240): peak, RMS, largest step between samples, level and residual of a sine at Tone, RMS of the reference, peak of signal minus reference. Frequency comes from zero crossings.",
    "Each band reports the signal level at its frequency, the gain from reference to signal and the coherence (Hann blocks of 16384 samples; a window shorter than one block gives no band result)."
  ],
  "audio-ports-in": [
    {"name": "Signal", "symbol": "signal"},
    {"name": "Reference", "symbol": "reference"}
  ],
  "audio-ports-out": [
    {"name": "Out", "symbol": "out"}
  ],
  "ports-control": [
    {"hasUI": 0, "display": "Measure", "symbol": "measure", "default": 0, "minimum": 0, "maximum": 16777215, "property": "integer"},
    {"hasUI": 1, "display": "Window", "symbol": "window", "default": 0.5, "minimum": 0.1, "maximum": 60, "unit": "s", "property": "logarithmic"},
    {"hasUI": 0, "display": "Tone", "symbol": "toneHz", "default": 1000, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 1", "symbol": "band1Hz", "default": 63, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 2", "symbol": "band2Hz", "default": 125, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 3", "symbol": "band3Hz", "default": 250, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 4", "symbol": "band4Hz", "default": 500, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 5", "symbol": "band5Hz", "default": 1000, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 6", "symbol": "band6Hz", "default": 2000, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 7", "symbol": "band7Hz", "default": 4000, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"},
    {"hasUI": 0, "display": "Band 8", "symbol": "band8Hz", "default": 8000, "minimum": 10, "maximum": 20000, "unit": "hz", "property": "logarithmic"}
  ],
  "ports-control-out": [
    {"display": "Result id", "symbol": "resultId", "minimum": 0, "maximum": 16777215, "property": "integer"},
    {"display": "Peak", "symbol": "peak", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "RMS", "symbol": "rms", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "DC", "symbol": "dc", "minimum": -10, "maximum": 10},
    {"display": "Crest", "symbol": "crest", "minimum": 0, "maximum": 240, "unit": "db"},
    {"display": "Non-finite", "symbol": "nonFinite", "minimum": 0, "maximum": 16777215, "property": "integer"},
    {"display": "Denormals", "symbol": "denormals", "minimum": 0, "maximum": 16777215, "property": "integer"},
    {"display": "Max step", "symbol": "maxStep", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Frequency", "symbol": "frequency", "minimum": 0, "maximum": 100000, "unit": "hz"},
    {"display": "Tone level", "symbol": "toneLevel", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Tone residual", "symbol": "toneResidual", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Ref RMS", "symbol": "refRms", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Diff peak", "symbol": "diffPeak", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 1 level", "symbol": "band1Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 1 gain", "symbol": "band1Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 1 coherence", "symbol": "band1Coherence", "minimum": 0, "maximum": 1},
    {"display": "Band 2 level", "symbol": "band2Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 2 gain", "symbol": "band2Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 2 coherence", "symbol": "band2Coherence", "minimum": 0, "maximum": 1},
    {"display": "Band 3 level", "symbol": "band3Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 3 gain", "symbol": "band3Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 3 coherence", "symbol": "band3Coherence", "minimum": 0, "maximum": 1},
    {"display": "Band 4 level", "symbol": "band4Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 4 gain", "symbol": "band4Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 4 coherence", "symbol": "band4Coherence", "minimum": 0, "maximum": 1},
    {"display": "Band 5 level", "symbol": "band5Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 5 gain", "symbol": "band5Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 5 coherence", "symbol": "band5Coherence", "minimum": 0, "maximum": 1},
    {"display": "Band 6 level", "symbol": "band6Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 6 gain", "symbol": "band6Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 6 coherence", "symbol": "band6Coherence", "minimum": 0, "maximum": 1},
    {"display": "Band 7 level", "symbol": "band7Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 7 gain", "symbol": "band7Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 7 coherence", "symbol": "band7Coherence", "minimum": 0, "maximum": 1},
    {"display": "Band 8 level", "symbol": "band8Level", "minimum": -240, "maximum": 40, "unit": "db"},
    {"display": "Band 8 gain", "symbol": "band8Gain", "minimum": -240, "maximum": 240, "unit": "db"},
    {"display": "Band 8 coherence", "symbol": "band8Coherence", "minimum": 0, "maximum": 1}
  ],
  "CPP": {"CLASS_NAME": "jp::MeterPedal", "INCLUDE": "plugins/meter/MeterPedal.h"}
}
